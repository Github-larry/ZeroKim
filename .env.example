# Copy to .env and edit. NEVER commit .env. Values below are placeholders, not secrets.
# Local database (docker-compose.yml). Host port 5433 avoids clashing with a Postgres already on 5432.
POSTGRES_USER=zerotrader
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_LOCAL_PASSWORD
POSTGRES_DB=zerotrader
POSTGRES_HOST_PORT=5433
